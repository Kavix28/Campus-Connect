# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==========================================
# ENVIRONMENT
# ==========================================
ENVIRONMENT=development
DEBUG=true
APP_VERSION=2.0.0

# ==========================================
# DATABASE
# ==========================================
# Options: sqlite, postgresql, mysql
DATABASE_TYPE=sqlite
# For SQLite:
DATABASE_PATH=./data/oudience.db
# For PostgreSQL/MySQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/oudience_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ==========================================
# SECURITY
# ==========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-key-min-32-bytes
JWT_SECRET=change-this-jwt-secret-min-32-bytes

# Admin credentials (use bcrypt hash for password)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=admin123

# API Keys for webhooks
WEBHOOK_API_KEY=dev-webhook-key-replace-in-production
WEBHOOK_SECRET_KEY=dev-webhook-secret-for-hmac-signing

# ==========================================
# EXTERNAL SERVICES
# ==========================================
# Email (SendGrid)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com

# SMS (Twilio  - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# REDIS (Optional)
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ==========================================
# SESSION
# ==========================================
SESSION_TIMEOUT=1800
SESSION_TYPE=filesystem
JWT_EXPIRY=2592000

# ==========================================
# AI/ML
# ==========================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_LENGTH=2000

# ==========================================
# MONITORING
# ==========================================
# Sentry (Error tracking - Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=./logs/oudience.log

# ==========================================
# WEBHOOK ENDPOINTS
# ==========================================
PUBLIC_WEBHOOK_URL=http://localhost:5001/api/v1/webhooks

# ==========================================
# CORS (Frontend integration)
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5001
CORS_CREDENTIALS=true

# ==========================================
# AUTOMATION
# ==========================================
# Enable automation workflows
AUTOMATION_ENABLED=true
WORKFLOW_RETRY_MAX_ATTEMPTS=3
WORKFLOW_RETRY_BACKOFF_FACTOR=2
