# General Environment
FLASK_APP=app.py
FLASK_ENV=production           # production | development
SECRET_KEY=change_this_to_a_very_secure_random_string_in_production
ALLOWED_EXTENSIONS=pdf
MAX_UPLOAD_SIZE_MB=10

# Security
SESSION_TYPE=filesystem
SESSION_TIMEOUT=1800
SESSION_TIMEOUT_MINUTES=30
ADMIN_PASSWORD_HASH=6c353db5c9b2521360098dfc3d77292261944883d6fa32dce78709041a773d2a  # SHA256 of 'password' — CHANGE THIS

# Database
DATABASE_TYPE=sqlite
DATABASE_PATH=./analytics.db

# LLM Configuration
LLM_PROVIDER=ollama            # local | ollama | openai
OLLAMA_HOST=http://ollama:11434
RAG_SIMILARITY_THRESHOLD=0.30

# Monitoring
ENABLE_METRICS=true

# =====================================================================
# Docker-Specific (set in docker-compose.prod.yml / dev.yml)
# =====================================================================
# HF_HOME=/app/model_cache
# PORT=5001
# PYTHONDONTWRITEBYTECODE=1
# PYTHONUNBUFFERED=1

# =====================================================================
# SECRETS BEST PRACTICES
# =====================================================================
# 1. Never commit .env to git  (it's in .gitignore)
# 2. Use Docker secrets or a vault for enterprise:
#    docker secret create app_secret_key ./secret_key.txt
# 3. Rotate SECRET_KEY and ADMIN_PASSWORD_HASH before production
# 4. For CI/CD, store secrets in GitHub repository settings:
#    Settings → Secrets → Actions → DOCKER_USERNAME, DOCKER_PASSWORD
